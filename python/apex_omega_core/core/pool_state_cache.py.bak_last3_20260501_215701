        keys = _apex_pool_keys(pool_address)

        # Local cache write-through.
        local = _apex_get_local_cache(self)
        for key in keys:
            local[key] = record

        redis = _apex_get_redis_adapter(self)
        if redis is not None:
            # Specialized method names first.
            for method_name in (
                "put_pool_state",
                "set_pool_state",
                "write_pool_state",
                "put_async",
                "set_async",
                "set_json",
                "json_set",
