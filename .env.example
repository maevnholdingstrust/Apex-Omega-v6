# Apex-Omega v6 master environment template
# Copy to .env locally. Never commit real secrets.

# ---------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------
CHAIN_ID=137
ENVIRONMENT=development
LIVE_TRADING_ENABLED=false
DRY_RUN=true
BROADCAST_ENABLED=false
APEX_SEND_TX=0
REAL_MARKET_DATA_ONLY=true
APEX_ALLOW_SYNTHETIC_TEST_DATA=false

# ---------------------------------------------------------------------------
# Polygon RPC endpoints
# ---------------------------------------------------------------------------
POLYGON_RPC=
POLYGON_HTTP=
POLYGON_WSS=
PRIVATE_RPC_URL=
# Provision this submission-only URL through Polygon Private Mempool access.
# Never substitute a public read RPC or an Ethereum builder relay.
POLYGON_PRIVATE_MEMPOOL_RPC_URL=
RPC_REQUEST_TIMEOUT_SEC=10

ALCHEMY_HTTP_1=
ALCHEMY_HTTP_2=
ALCHEMY_WSS_1=
ALCHEMY_WSS_2=
INFURA_HTTP=
INFURA_WSS=
PUBLIC_DRPC=

# Optional read-side public RPC discovery. Never use discovered public RPCs as
# final live transaction submission authority.
DODO_RPC_DISCOVERY_ENABLED=false
DODO_RPC_PROVIDER_URL=http://127.0.0.1:3000
DODO_RPC_DISCOVERY_SOURCES=ChainList
DODO_RPC_DISCOVERY_TIMEOUT_SEC=2
DODO_RPC_DISCOVERY_CACHE_TTL_SEC=300
DODO_RPC_DISCOVERY_MAX_ENDPOINTS=12

# ---------------------------------------------------------------------------
# MEV / private relay endpoints
# ---------------------------------------------------------------------------
# Ethereum-only builder lane. Do not use for Polygon PoS submission.
TITAN_MEV_US_WEST=
FASTLANE_RELAY=
MARLIN_RELAY=
FLASHBOTS_RELAY=
BUNDLE_TARGET_BLOCK_OFFSET=1
BUNDLE_MAX_BLOCK_WINDOW=5

# ---------------------------------------------------------------------------
# Wallet and signing
# ---------------------------------------------------------------------------
EXECUTOR_PRIVATE_KEY=
BUNDLE_SIGNER_PRIVATE_KEY=
EXECUTOR_WALLET_ADDRESS=
OPERATOR_ADDRESS=
PROFIT_RECIPIENT_ADDRESS=

# ---------------------------------------------------------------------------
# Deployed executor contracts on Polygon
# ---------------------------------------------------------------------------
C1_INSTITUTIONAL_EXECUTOR_ADDRESS=
C2_ULTIMATE_ARBITRAGE_EXECUTOR_ADDRESS=
AAVE_V3_POOL_ADDRESS=0x794a61358D6845594F94dc1Db02A252b5b4814aD
BALANCER_VAULT_ADDRESS=0xBA12222222228d8Ba445958a75a0704d566BF2C8
BALANCER_API_DISCOVERY_ENABLED=true
BALANCER_API_URL=https://api-v3.balancer.fi/
BALANCER_API_FIRST=250
BALANCER_MAX_TOKENS_PER_POOL=5
BALANCER_API_MIN_TVL_USD=5000
LIVE_QUOTE_START_SYMBOLS=USDCe,USDC,USDT,DAI,WMATIC,WETH,WBTC
LIVE_QUOTE_ALLOW_REPEATED_POOL_CYCLES=true
LIVE_QUOTE_PRERANK_ENABLED=true
LIVE_QUOTE_WORKERS=16
LIVE_QUOTE_ADAPTIVE_SIZE_ENABLED=true
LIVE_QUOTE_ADAPTIVE_SIZE_FRACTIONS=0.10,0.15,0.25,0.50,0.75,1.0
LIVE_QUOTE_RECORD_LIMIT=0
PRICE_EXTERNAL_ENABLED=true
COINGECKO_PRICE_ENABLED=true
COINGECKO_API=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
MORALIS_PRICE_ENABLED=false
MORALIS_API_KEY=

# ---------------------------------------------------------------------------
# Risk gates and execution thresholds
# ---------------------------------------------------------------------------
MIN_NET_PROFIT_USD=1.00
MIN_RAW_SPREAD_BPS=1.00
MAX_ROUTE_SLIPPAGE_BPS=100.00
MAX_MEMPOOL_DEGRADATION_BPS=200.00
MIN_POOL_TVL_USD=5000.00
MAX_TRADE_TO_POOL_RATIO_BPS=500.00
RISK_BUFFER_USD=0.00

# ---------------------------------------------------------------------------
# Flashloan sizing
# ---------------------------------------------------------------------------
MIN_FLASH_LOAN_USD=1000
MAX_FLASH_LOAN_USD=100000
AUTONOMOUS_MAX_FLASHLOAN_CAP_USD=100000
LIVE_QUOTE_TVL_CAP_BPS_2_HOP=1500
LIVE_QUOTE_TVL_CAP_BPS_3_HOP=1250
LIVE_QUOTE_TVL_CAP_BPS_4_HOP=1000

# ---------------------------------------------------------------------------
# Cost model
# ---------------------------------------------------------------------------
C1_GAS_USD=0.38
C2_GAS_USD=0.55
FLASH_LOAN_FEE_BPS=5.00
MAX_FEE_PER_GAS_GWEI=
MAX_PRIORITY_FEE_PER_GAS_GWEI=

# ---------------------------------------------------------------------------
# Dashboard/API
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8080
WEBSOCKET_HOST=127.0.0.1
WEBSOCKET_PORT=8090
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Logging / audit
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
OPPORTUNITY_LOG_PATH=logs/opportunities.jsonl
REJECTION_LOG_PATH=logs/rejections.jsonl
AUDIT_LOG_PATH=logs/audit.jsonl

C1_ARB_EXECUTOR_ADDRESS=0x222F3B6b1ae90c279addA5b0eA0D8e87E49262Ac

C2_ARB_EXECUTOR_ADDRESS=0x8B04b0db6e803Bc29C3327885351D4297ABad9BE

C1_TARGET=0x222F3B6b1ae90c279addA5b0eA0D8e87E49262Ac

C2_TARGET=0x8B04b0db6e803Bc29C3327885351D4297ABad9BE

LIQUIDATION_EXECUTOR_ADDRESS=0xF9a28f389Ad8c33F9da68c736BEAf1F2A3795a56

# Optional SaaS split deployment targets. Leave empty until split contracts are deployed and verified.
EXECUTOR_ADDRESS_SAAS=
C1_TARGET_SAAS=
C2_TARGET_SAAS=
LIQUIDATION_EXECUTOR_ADDRESS_SAAS=
SAAS_TREASURY_ADDRESS=
